{
  "appId": "com.nomaen.homeworkout",
  "appName": "SimpleWorkoutGen",
  "webDir": "www",
  "server": {
    "iosScheme": "ionic"
  },
  "ios": {
    "scheme": "App",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a0f",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "native",
      "style": "DARK"
    }
  }
}
