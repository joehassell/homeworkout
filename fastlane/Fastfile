fastlane_version "2.226.0"
default_platform(:ios)

require "json"

REPO_ROOT      = File.expand_path("..", __dir__)
XCODE_PROJECT  = File.join(REPO_ROOT, "ios/App/App.xcodeproj")
SCHEME         = "App"
TEAM_ID        = "T33B88TGA8"
BUILD_DIR      = File.join(REPO_ROOT, "build")
IPA_NAME       = "App.ipa"
IPA_PATH       = File.join(BUILD_DIR, IPA_NAME)
ASC_CONFIG     = File.expand_path("~/.appstoreconnect/config.json")

def asc_api_key
  unless File.exist?(ASC_CONFIG)
    UI.user_error!("App Store Connect API key not configured. Run: ./scripts/release.sh setup")
  end
  cfg = JSON.parse(File.read(ASC_CONFIG))
  app_store_connect_api_key(
    key_id:       cfg.fetch("key_id"),
    issuer_id:    cfg.fetch("issuer_id"),
    key_filepath: File.expand_path(cfg.fetch("key_filepath")),
    duration:     1200,
    in_house:     false
  )
end

def truthy?(val)
  return val if val.is_a?(TrueClass) || val.is_a?(FalseClass)
  %w[true 1 yes].include?(val.to_s.downcase)
end

platform :ios do
  desc "Verify the App Store Connect API key authenticates"
  lane :test_auth do
    key = asc_api_key
    UI.success("API key OK — issuer #{key[:issuer_id]}, key #{key[:key_id]}")
  end

  desc "Archive App scheme and export an App Store IPA"
  lane :archive do
    asc_api_key  # warm cache; gym uses it implicitly when uploading symbols
    build_app(
      project:            XCODE_PROJECT,
      scheme:             SCHEME,
      configuration:      "Release",
      output_directory:   BUILD_DIR,
      output_name:        IPA_NAME,
      clean:              true,
      include_symbols:    true,
      include_bitcode:    false,
      export_method:      "app-store",
      export_options: {
        method:        "app-store",
        signingStyle:  "automatic",
        teamID:        TEAM_ID,
        uploadSymbols: true,
        uploadBitcode: false
      },
      xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Upload IPA + metadata + screenshots to App Store Connect and (optionally) submit"
  lane :upload do |options|
    submit       = truthy?(options.fetch(:submit, false))
    auto_release = truthy?(options.fetch(:auto_release, false))
    skip_binary  = truthy?(options.fetch(:skip_binary, false))

    upload_to_app_store(
      api_key:                          asc_api_key,
      ipa:                              skip_binary ? nil : IPA_PATH,
      skip_binary_upload:               skip_binary,
      skip_screenshots:                 false,
      skip_metadata:                    false,
      force:                            true,
      run_precheck_before_submit:       submit,
      precheck_include_in_app_purchases: false,
      submit_for_review:                submit,
      automatic_release:                auto_release,
      phased_release:                   false,
      reject_if_possible:               false,
      submission_information: {
        add_id_info_uses_idfa:                       false,
        export_compliance_uses_encryption:           false,
        export_compliance_encryption_updated:        false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Full release: archive + upload + submit for review"
  lane :release do |options|
    skip_build   = truthy?(options.fetch(:skip_build, false))
    skip_upload  = truthy?(options.fetch(:skip_upload, false))
    skip_submit  = truthy?(options.fetch(:skip_submit, false))
    auto_release = truthy?(options.fetch(:auto_release, false))

    archive unless skip_build

    unless skip_upload
      upload(
        submit:       !skip_submit,
        auto_release: auto_release,
        skip_binary:  false
      )
    end
  end

  desc "Push metadata + screenshots only (no new build, no review submission)"
  lane :metadata_only do
    upload(submit: false, auto_release: false, skip_binary: true)
  end
end
